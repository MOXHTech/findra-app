{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    // Off (rather than per-file-excluded): src/lib/bindings.ts is
    // regenerated by tauri-specta on every `cargo run --bin
    // export_bindings`/debug build and always includes a couple of
    // currently-unused exports (TAURI_CHANNEL, __makeEvents__) reserved
    // for event bindings this app doesn't use yet - not worth fighting the
    // generator over.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
