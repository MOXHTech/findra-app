{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Findra",
  "mainBinaryName": "findra-app",
  "version": "0.1.0",
  "identifier": "com.findra.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Findra",
        "width": 980,
        "height": 620,
        "minWidth": 640,
        "minHeight": 400,
        "center": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:"
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "tooltip": "Findra"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis", "deb", "rpm", "appimage"],
    "publisher": "findra",
    "copyright": "findra",
    "category": "Utility",
    "shortDescription": "Instant full-disk file search",
    "longDescription": "Findra is the graphical front end for the findra file search engine: a menu-bar/tray-resident app that gives millisecond file name and path search over an index kept live by the findra background daemon.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": null
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/findra/findra-app/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyQ0YyOTVEQkYyMTA2RDgKUldUWUJpRy9YU25QUXJIT3A4Nzl5bEV1N3NJTjFjM2tvc2x1Q2ZTY0E1aGtrZldwVFBsbnF4eWYK"
    }
  }
}
